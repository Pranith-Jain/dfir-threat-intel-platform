      "id": "2025-12-29-copilot-studio-connected-agents",
      "title": "Copilot Studio \"Connected Agents\" can carry invisible backdoors",
      "date": "2025-12-29",
      "dateEnd": null,
      "month": "2025-12",
      "kind": "research",
      "types": ["IPI"],
      "severity": "medium",
      "confidence": "A",
