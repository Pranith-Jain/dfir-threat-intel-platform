# Agent skill submodules — each is its own git repo, not part of the main tree
agent/cti-ai-skills/
agent/dfir-ai-skills/

# Duplicate ECC skill bundles — NOT canonical. The single source of truth is
# .agents/skills/ (git-tracked, 35 skills, pinned by skills-lock.json).
# `skills/` and `agent/skills/` are untracked local copies that drift; ignore
# them so they never get committed by accident. pi loads skills from
# ~/.pi/agent/skills/ (user-level), not from any repo dir.
#
# These MUST stay anchored with a leading slash. A bare `skills/` has no
# leading or interior slash, so per gitignore(5) it also matches at ANY level
# — including .agents/skills/, the canonical bundle. Tracked files survive,
# but every NEW skill file there would be silently un-addable.
/skills/
/agent/skills/

# pi's local ECC bundle. Another copy of the skills above — pi reads these
# from the repo dir, so unlike ~/.pi/agent/skills/ this one is per-checkout
# and must never be committed.
/.pi/


# Security Investigator local upstream-tracking folder — regenerated by
# scripts/sync-si-from-upstream.mjs (sparse git clone of upstream). NOT
# committed because the canonical source of truth is the public/data/si/
# build output, which is itself committed.
security-investigator-replication/
signature-base-replication/

# Local-only download artifacts (page-as-html from edge cache or scraper)
/Threat*
.mimocode/

!/threat-intel-staging/
threat-intel-staging/*

# detection.wiki sync staging output
detection-wiki-staging/

# Webamon DTB sync staging output
webamon-dtb-staging/

# Daily Briefs sync staging output (raw HTML from upstream, rebuilt into public/data)
daily-briefs-staging/

# PCMedicalist feed sync staging output (4.6MB/day raw digests)
pcmedicalist-staging/

# secrets-regex module is a tracked source file, not a credential
!api/src/lib/secrets-regex.ts

# Briefing export output (transient, pushed to daily-threat-brief by CI)
briefings-out/

# Reddit feed artifact — published to the reddit-feed-data branch by CI, not committed
reddit-feed.json
# Telegram RSS cache artifact — published to the telegram-rss-cache branch by CI, not committed
telegram-rss-cache.json
og-overrides.generated.json

# build-time OG page cards (uploaded to KV by scripts/upload-page-og.mjs)
.og-cache/

# Tesseract runtime blobs — copied from node_modules by
# scripts/sync-tesseract-assets.mjs (runs in `dev` and `prebuild`). These were
# ~7.9 MB of byte-identical copies of files tesseract.js / tesseract.js-core
# already ship; a committed copy just went stale on every version bump.
public/tesseract/*.wasm.js
public/tesseract/worker.min.js

# The English language model (~10.9 MB) is the exception: no npm package
# ships it, and langPath resolves here at runtime, so it must stay committed.
!public/tesseract/eng.traineddata.gz

# Sync intermediates — regenerated by scripts/sync-* + CI workflows, never committed
/actors-staging/
/daily-briefs-staging/
/ai-threats-staging/
/webamon-dtb-staging/
/oss-feeds-staging/
/threat-intel-staging/*
# Committed small sources: ransomware-groups sync staging (reproducible builds
# when upstreams flap) + ai-escape curatorial seed (source of truth) +
# anarchy catalog (daily sync, small JSON).
!/threat-intel-staging/ransomware-groups/
!/threat-intel-staging/ai-escape/
!/threat-intel-staging/anarchy.json

# One-off API probe dumps from ad-hoc debugging (curl responses parked at the
# repo root, e.g. p.json / tm2.json from a threat-map debug session). Nothing
# reads them and nothing regenerates them, so they only ever showed up as noise
# in `git status` — or worse, in someone's next commit. Delete them; don't
# commit them.
/p.json
/tm2.json
