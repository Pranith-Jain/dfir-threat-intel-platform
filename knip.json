{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/main.tsx", "src/entry-server.tsx", "src/App.tsx", "index.html"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/**/*.d.ts"]
    },
    "api": {
      "entry": ["api/src/index.ts", "api/src/env.ts"],
      "project": ["api/src/**/*.{ts,tsx}", "worker/**/*.{ts,tsx}"],
      "ignore": ["**/*.d.ts", "api/src/lib/**/*.ts"]
    }
  },
  "entry": [
    "src/main.tsx",
    "src/entry-server.tsx",
    "index.html",
    "api/src/index.ts",
    "worker/index.ts",
    "worker/scheduled.ts",
    "worker/queue-consumer.ts",
    "worker/mcp-server.ts",
    "api/test/**/*.test.ts",
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "eslint-rules/**/*.js",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "api/src/**/*.{ts,tsx}", "worker/**/*.{ts,tsx}", "eslint-rules/**/*.js"],
  "ignore": [
    "**/*.d.ts",
    "**/node_modules/**",
    "dist/**",
    ".ssr-build/**",
    ".wrangler/**",
    "public/**",
    "api/src/lib/**/*.ts",
    "api/src/resvg-shared.ts",
    "social-content/**",
    "threat-intel-staging/**",
    "oss-feeds-staging/**",
    "agent/**",
    "migrations/**"
  ],
  "ignoreDependencies": [
    "hono",
    "openapi-typescript",
    "telegram",
    "input",
    "prop-types",
    "rollup-plugin-visualizer",
    "preact",
    "preact-render-to-string",
    "tesseract.js-core",
    "@types/js-yaml",
    "@typescript-eslint/eslint-plugin"
  ],
  "ignoreBinaries": ["vitest", "wrangler", "eslint", "prettier", "tsc"],
  "includeEntryExports": false
}
