{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/entry-server.tsx",
        "index.html",
        "worker/scheduled.ts",
        "worker/queue-consumer.ts",
        "worker/mcp-server.ts",
        "src/**/*.test.{ts,tsx}",
        "src/**/__tests__/**/*.{ts,tsx}",
        "eslint-rules/**/*.js",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "worker/**/*.{ts,tsx}", "eslint-rules/**/*.js"]
    },
    "api": {
      "entry": ["src/env.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "openapi-typescript",
    "preact",
    "preact-render-to-string",
    "tesseract.js-core",
    "@types/js-yaml",
    "@typescript-eslint/eslint-plugin",
    "cloudflare"
  ],
  "ignoreBinaries": ["gitleaks"],
  "includeEntryExports": false
}
